rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Product categories — anyone can browse, only the signed-in admin can edit
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Product catalog — anyone can browse, only the signed-in admin can edit
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Business settings (name, WhatsApp number, Instagram) — public read, admin-only write
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders — anyone can place one (guest checkout), only admin can list/read/update them
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Customer accounts — phone number is the document ID
    match /customers/{phone} {
      allow get: if true;
      allow create: if true;
      allow list, update, delete: if request.auth != null;
    }
  }
}
